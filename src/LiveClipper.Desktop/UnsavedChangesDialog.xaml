<Window x:Class="LiveClipper.Desktop.UnsavedChangesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LiveClipper"
        Width="460" SizeToContent="Height" MinHeight="200"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="Transparent"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FocusManager.FocusedElement="{Binding ElementName=StayButton}">
    <Border x:Name="Frame" Background="#151515" BorderBrush="#333333" BorderThickness="1">
        <Grid Margin="24,20,24,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="Accent" Grid.Column="0" Background="#ff9a3c" Margin="0,2,0,2"/>
                <TextBlock x:Name="TitleText" Grid.Column="1" Margin="12,0,8,0" Text="仍有未保存的修改"
                           FontSize="18" FontWeight="SemiBold" Foreground="#F2F2F2" TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
                <Button x:Name="CloseButton" Grid.Column="2" Content="✕" Width="32" Height="32"
                        AutomationProperties.Name="关闭并留在编辑器" Click="OnStay"
                        Background="Transparent" Foreground="#BDBDBD" BorderThickness="0" Cursor="Hand"/>
            </Grid>
            <TextBlock x:Name="ReasonText" Grid.Row="1" Margin="16,16,0,0" FontSize="14"
                       Foreground="#D8D8D8" TextWrapping="Wrap" LineHeight="21"/>
            <TextBlock x:Name="WarnText" Grid.Row="2" Margin="16,10,0,0" FontSize="14"
                       Foreground="#ff9a3c" TextWrapping="Wrap" LineHeight="21"
                       Text="现在退出，未保存的修改可能丢失。"/>
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button x:Name="LeaveButton" Content="仍然退出" MinWidth="104" Height="36" Margin="0,0,10,0"
                        Padding="14,0" Click="OnLeave" Background="#232323" Foreground="#F2F2F2"
                        BorderBrush="#4A4A4A" BorderThickness="1" TabIndex="1"/>
                <Button x:Name="StayButton" Content="留在编辑器" MinWidth="116" Height="36"
                        Padding="14,0" Click="OnStay" IsDefault="True" IsCancel="True"
                        Background="#ff9a3c" Foreground="#151515" FontWeight="SemiBold"
                        BorderBrush="#ff9a3c" BorderThickness="1" TabIndex="0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
